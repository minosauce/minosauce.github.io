<link
  rel="stylesheet"
  href="{{ '/assets/css/about-showcase.css' | relative_url }}"
>


<!-- =========================================================
     Publications
     ========================================================= -->

<section class="about-publication-block">

  <h2 class="home-section-title">
    <a
      href="{{ '/publications/' | relative_url }}"
      style="color: inherit"
    >
      Publications
    </a>
  </h2>

  <div
    class="publications home-publications about-paginated-publications"
    data-publication-pagination
    data-per-page="5"
  >
    {% bibliography %}
  </div>

</section>


<!-- =========================================================
     Projects
     ========================================================= -->

<section class="about-carousel-section">

  <h2 class="home-section-title">
    <a
      href="{{ '/projects/' | relative_url }}"
      style="color: inherit"
    >
      Projects
    </a>
  </h2>

  {% assign recent_projects = site.projects | sort: 'date' | reverse %}

  <div
    class="about-carousel about-project-carousel"
    data-about-carousel
  >

    <button
      class="about-carousel-arrow about-carousel-prev"
      type="button"
      aria-label="Previous projects"
    >
      ‹
    </button>

    <div
      class="about-carousel-track"
      data-carousel-track
    >

      {% for project in recent_projects %}

        <div class="about-carousel-slide about-project-slide">

          <div class="projects about-project-card-host">

            {% include projects.liquid project=project %}

          </div>

        </div>

      {% endfor %}

    </div>

    <button
      class="about-carousel-arrow about-carousel-next"
      type="button"
      aria-label="Next projects"
    >
      ›
    </button>

  </div>

</section>


<!-- =========================================================
     Repositories
     ========================================================= -->

{% if site.data.repositories.github_repos %}

  <section class="about-carousel-section">

    <h2 class="home-section-title">
      <a
        href="{{ '/repositories/' | relative_url }}"
        style="color: inherit"
      >
        Repositories
      </a>
    </h2>

    {% assign reversed_github_repos = site.data.repositories.github_repos | reverse %}

    <div
      class="about-carousel about-repository-carousel"
      data-about-carousel
    >

      <button
        class="about-carousel-arrow about-carousel-prev"
        type="button"
        aria-label="Previous repositories"
      >
        ‹
      </button>

      <div
        class="about-carousel-track"
        data-carousel-track
      >

        {% for repo in reversed_github_repos %}

          <div class="about-carousel-slide about-repository-slide">

            <div class="repositories about-repository-card-host">

              {% include repository/repo.liquid repository=repo %}

            </div>

          </div>

        {% endfor %}

      </div>

      <button
        class="about-carousel-arrow about-carousel-next"
        type="button"
        aria-label="Next repositories"
      >
        ›
      </button>

    </div>

  </section>

{% endif %}


<script src="{{ '/assets/js/about-showcase.js' | relative_url }}"></script>
