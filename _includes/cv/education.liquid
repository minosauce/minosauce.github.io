<div class="cv-group-list">
  {% assign organization_groups = entries | group_by: 'institution' %}

  {% for group in organization_groups %}
    {% assign first_entry = group.items | first %}
    {% assign group_entries = group.items | al_cv_sort_by_date %}

    <div class="cv-org-group">
      <!--
        ==================================================
        Institution header
        ==================================================
      -->
      <div class="cv-org-header">
        {% if first_entry.logo %}
          <div class="cv-org-logo-box">
            <img
              class="cv-org-logo"
              src="{{ first_entry.logo | relative_url }}"
              alt="{{ group.name }} logo"
              loading="lazy"
            >
          </div>
        {% endif %}

        <div class="cv-org-info">
          <div class="cv-org-name">
            {{ group.name }}
          </div>

          {% if first_entry.location %}
            <div class="cv-org-location">
              <i class="fa-solid fa-location-dot"></i>
              <span>{{ first_entry.location }}</span>
            </div>
          {% endif %}
        </div>
      </div>

      <!--
        ==================================================
        Degrees
        ==================================================
      -->
      <div class="cv-role-list">
        {% for entry in group_entries %}
          {% assign study_type = entry.studyType | default: entry.degree %}

          <div class="cv-role-row">
            <!-- Date -->
            <div class="cv-role-date">
              {% include cv/date_range.liquid entry=entry %}
            </div>

            <!-- Degree information -->
            <div class="cv-role-body">
              {% if study_type or entry.area %}
                <div class="cv-role-title">
                  {% if study_type %}
                    <span class="cv-degree-type">
                      {{ study_type }}
                    </span>
                  {% endif %}

                  {% if entry.area %}
                    <span
                      class="cv-degree-area"
                      style="
                        margin-left: 0.8rem;
                        font-weight: 400;
                        font-style: italic;
                      "
                    >
                      {{ entry.area }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}

              {% if entry.score %}
                <div class="cv-role-detail">GPA: {{ entry.score }}</div>
              {% endif %}

              {% if entry.courses or entry.highlights %}
                <ul class="cv-role-highlights">
                  {% if entry.courses %}
                    {% for item in entry.courses %}
                      <li>
                        {{ item }}
                      </li>
                    {% endfor %}
                  {% endif %}

                  {% if entry.highlights %}
                    {% for item in entry.highlights %}
                      <li>
                        {{ item | markdownify | remove: '<p>' | remove: '</p>' }}
                      </li>
                    {% endfor %}
                  {% endif %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
