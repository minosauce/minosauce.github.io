{% comment %}
  Custom News List

  Desktop:
  Aug 24, 2026 | News title | Thumbnail

  Mobile:
  Aug 24,       | News title | Thumbnail
  2026

  Supported image fields:
  img:
  image:
  thumbnail:
  preview:
{% endcomment %}

{% assign news_items = site.news | sort: 'date' | reverse %}

{% if include.per_page %}
  {% assign news_per_page = include.per_page %}
{% elsif include.limit %}
  {% assign news_per_page = page.announcements.limit | default: 5 %}
{% else %}
  {% assign news_per_page = 0 %}
{% endif %}

{% if news_per_page > 0 %}
<div
  data-news-pagination
  data-per-page="{{ news_per_page }}"
>
{% endif %}

<div class="news-list-custom">


  {% for item in news_items %}

    {% assign preview_image = item.img %}

    {% unless preview_image %}
      {% assign preview_image = item.image %}
    {% endunless %}

    {% unless preview_image %}
      {% assign preview_image = item.thumbnail %}
    {% endunless %}

    {% unless preview_image %}
      {% assign preview_image = item.preview %}
    {% endunless %}

    <div
      class="
        news-item
        {% unless preview_image %}
          news-item-no-preview
        {% endunless %}
      "
    >

      <!-- Date -->
      <time
        class="news-date"
        datetime="{{ item.date | date: '%Y-%m-%d' }}"
      >
        <span class="news-date-main">
          {{ item.date | date: "%b %-d," }}
        </span>
        <span class="news-date-year">
          {{ item.date | date: "%Y" }}
        </span>
      </time>

      <!-- Title / inline news -->
      <div class="news-content">

        {% if item.inline %}

          <div class="news-title">
            {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
          </div>

        {% else %}

          <a
            class="news-title"
            href="{{ item.url | relative_url }}"
          >
            {{ item.title }}
          </a>

        {% endif %}

      </div>

      <!-- Thumbnail -->
      {% if preview_image %}

        {% assign image_src = preview_image %}

        {% unless preview_image contains '://' %}
          {% assign image_src = preview_image | relative_url %}
        {% endunless %}

        <a
          class="news-thumbnail"
          href="{{ item.url | relative_url }}"
          aria-label="{{ item.title }}"
        >
          <img
            src="{{ image_src }}"
            alt="{{ item.title }}"
            loading="lazy"
          >
        </a>

      {% endif %}

    </div>

  {% endfor %}

</div>

{% if news_per_page > 0 %}
</div>
{% endif %}
