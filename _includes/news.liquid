{% comment %}
  News list

  Usage:

  Full News page:
  {% include news.liquid per_page=15 %}

  About page:
  {% include news.liquid per_page=5 %}
{% endcomment %}

{% assign sorted_news = site.news | sort: 'date' | reverse %}

{% assign news_per_page = include.per_page | default: 15 %}

<div
  class="news-pagination-container"
  data-news-pagination
  data-per-page="{{ news_per_page }}"
>
  <div class="news-list-custom">
    {% for item in sorted_news %}

      {% assign news_image = item.img | default: item.image | default: item.thumbnail %}

      {% if news_image %}
        <div class="news-item">

          <div class="news-date">
            {{ item.date | date: "%b %d, %Y" }}
          </div>

          <div class="news-content">
            <div class="news-title">
              {% if item.redirect %}
                <a
                  href="{{ item.redirect }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {{ item.title }}
                </a>
              {% else %}
                <a href="{{ item.url | relative_url }}">
                  {{ item.title }}
                </a>
              {% endif %}
            </div>
          </div>

          <div class="news-thumbnail">
            {% if item.redirect %}
              <a
                href="{{ item.redirect }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  src="{{ news_image | relative_url }}"
                  alt="{{ item.title }}"
                  loading="lazy"
                >
              </a>
            {% else %}
              <a href="{{ item.url | relative_url }}">
                <img
                  src="{{ news_image | relative_url }}"
                  alt="{{ item.title }}"
                  loading="lazy"
                >
              </a>
            {% endif %}
          </div>

        </div>

      {% else %}

        <div class="news-item news-item-no-preview">

          <div class="news-date">
            {{ item.date | date: "%b %d, %Y" }}
          </div>

          <div class="news-content">
            <div class="news-title">
              {% if item.redirect %}
                <a
                  href="{{ item.redirect }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {{ item.title }}
                </a>
              {% else %}
                <a href="{{ item.url | relative_url }}">
                  {{ item.title }}
                </a>
              {% endif %}
            </div>
          </div>

        </div>

      {% endif %}

    {% endfor %}
  </div>
</div>
