---
layout: default
---
{% assign cv = site.data.cv.cv %}

<div class="post cv-page">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}

      {% if page.cv_pdf %}
        <a
          href="{{ page.cv_pdf | relative_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
  </header>

  <article>
    <div class="cv">
      <!--
        ==================================================
        Contact Information
        ==================================================
      -->

      <a class="anchor" id="contact-information"></a>

      <div class="card mt-3 p-3">
        <h3 class="card-title font-weight-medium">Contact Information</h3>

        <table class="table table-cv table-sm table-borderless">
          {% if cv.name %}
            <tr>
              <td class="p-1 pr-2 font-weight-bold"><b>Name</b></td>
              <td class="p-1 pl-2 font-weight-light">{{ cv.name }}</td>
            </tr>
          {% endif %}

          {% if cv.label %}
            <tr>
              <td class="p-1 pr-2 font-weight-bold"><b>Professional Title</b></td>
              <td class="p-1 pl-2 font-weight-light">{{ cv.label }}</td>
            </tr>
          {% endif %}

          {% if cv.email %}
            <tr>
              <td class="p-1 pr-2 font-weight-bold"><b>Email</b></td>
              <td class="p-1 pl-2 font-weight-light">{{ cv.email }}</td>
            </tr>
          {% endif %}

          {% if cv.address %}
            <tr>
              <td class="p-1 pr-2 font-weight-bold"><b>Location</b></td>

              <td class="p-1 pl-2 font-weight-light">
                {% if cv.address.street %}
                  {{ cv.address.street }},
                {% endif %}

                {% if cv.address.city %}
                  {{ cv.address.city }},
                {% endif %}

                {% if cv.address.region %}
                  {{ cv.address.region }}
                {% endif %}

                {% if cv.address.postalCode %}
                  {{ cv.address.postalCode }}
                {% endif %}
              </td>
            </tr>
          {% endif %}
        </table>
      </div>

      <!--
        ==================================================
        Experience
        ==================================================
      -->

      {% if cv.sections.Experience %}
        <a class="anchor" id="experience"></a>

        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Experience</h3>

          {% assign entries = cv.sections.Experience | al_cv_sort_by_date %}
          {% include cv/experience.liquid %}
        </div>
      {% endif %}

      <!--
        ==================================================
        Education
        ==================================================
      -->

      {% if cv.sections.Education %}
        <a class="anchor" id="education"></a>

        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Education</h3>

          {% assign entries = cv.sections.Education | al_cv_sort_by_date %}
          {% include cv/education.liquid %}
        </div>
      {% endif %}

      <!--
        ==================================================
        Professional Service
        ==================================================
      -->

      {% assign professional_service = cv.sections['Professional Service'] %}

      {% if professional_service %}
        <a class="anchor" id="professional-service"></a>

        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Professional Service</h3>

          {% assign entries = professional_service %}
          {% include cv/professional_service.liquid %}
        </div>
      {% endif %}

      <!--
        ==================================================
        Awards
        ==================================================
      -->

      {% if cv.sections.Awards %}
        <a class="anchor" id="awards"></a>

        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Awards</h3>

          {% assign entries = cv.sections.Awards %}
          {% include cv/awards.liquid %}
        </div>
      {% endif %}

      <!--
        ==================================================
        Certificates
        ==================================================
      -->

      {% if cv.sections.Certificates %}
        <a class="anchor" id="certificates"></a>

        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Certificates</h3>

          {% assign entries = cv.sections.Certificates %}
          {% include cv/certificates.liquid %}
        </div>
      {% endif %}

      <!--
        ==================================================
        Skills
        ==================================================
      -->

      {% if cv.sections.Skills %}
        <a class="anchor" id="skills"></a>

        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Skills</h3>

          {% assign entries = cv.sections.Skills %}
          {% include cv/skills.liquid %}
        </div>
      {% endif %}

      <!--
        ==================================================
        Languages
        ==================================================
      -->

      {% if cv.sections.Languages %}
        <a class="anchor" id="languages"></a>

        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Languages</h3>

          {% assign entries = cv.sections.Languages %}
          {% include cv/languages.liquid %}
        </div>
      {% endif %}

      <!--
        ==================================================
        Interests
        ==================================================
      -->

      {% if cv.sections.Interests %}
        <a class="anchor" id="interests"></a>

        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Interests</h3>

          {% assign entries = cv.sections.Interests %}
          {% include cv/interests.liquid %}
        </div>
      {% endif %}
    </div>
  </article>
</div>
